# Runtime connection: Supabase transaction pooler (Supavisor), port 6543.
# Percent-encode the password (# -> %23, / -> %2F, , -> %2C). Do not add ?sslmode=... (see DATABASE_SSL).
DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Migrations and seed: Supabase session pooler, port 5432 (IPv4). The db.<ref>.supabase.co host is IPv6-only.
DATABASE_DIRECT_URL=postgresql://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# TLS to the database. true for Supabase, false for a local Docker Postgres.
DATABASE_SSL=true

# Disposable database for API tests (npm run test:db:up starts it). Never point this at Supabase.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/acme_test

SESSION_SECRET=<long random string>
HR_SEED_EMAIL=hr@acme.example
HR_SEED_PASSWORD=<password for the HR login>
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
